# Copiar este archivo como secrets.toml y llenar con las credenciales reales.
# secrets.toml NO se sube al repo (está en .gitignore).

# === 1) http-to-bucket: guarda el parquet de la fuente HTTP en MinIO (bucket "taxis") ===
[http_to_bucket.destination.filesystem]
bucket_url = "s3://taxis"

[http_to_bucket.destination.filesystem.credentials]
aws_access_key_id = "admin"
aws_secret_access_key = "password"
endpoint_url = "http://minio:9000"

# === 2) parquet-to-iceberg: lee el parquet de "taxis" y lo escribe como tabla Iceberg
#         en el bucket "my-bucket", usando el catálogo de Nessie ===
[parquet_to_iceberg.destination.filesystem]
bucket_url = "s3://my-bucket"

[parquet_to_iceberg.destination.filesystem.credentials]
aws_access_key_id = "admin"
aws_secret_access_key = "password"
endpoint_url = "http://minio:9000"

# Catálogo de Nessie (REST) que usa dlt/pyiceberg para registrar la tabla Iceberg
[iceberg_catalog]
iceberg_catalog_name = "nessie"
iceberg_catalog_type = "rest"

[iceberg_catalog.iceberg_catalog_config]
type = "rest"
uri = "http://nessie:19120/iceberg/"
warehouse = "warehouse"
py-io-impl = "pyiceberg.io.fsspec.FsspecFileIO"
"s3.endpoint" = "http://minio:9000"
"s3.access-key-id" = "admin"
"s3.secret-access-key" = "password"
"s3.path-style-access" = "true"

# === 3) minio-to-azure: mueve el parquet de Iceberg desde MinIO hacia Azure (carpeta del grupo) ===
[minio_to_azure.destination.filesystem]
bucket_url = "abfss://clase-4-dlt@fhbd.dfs.core.windows.net/GRUPO_3"

[minio_to_azure.destination.filesystem.credentials]
azure_storage_account_name = "fhbd"
azure_storage_account_key = "PEGAR_AQUI_LA_KEY_QUE_DIO_EL_PROFE"

# === 4) minio-to-clickhouse: inserta el parquet de Iceberg en ClickHouse ===
[minio_to_clickhouse.destination.clickhouse.credentials]
host = "clickhouse"
port = 9000
http_port = 8123
username = "default"
password = "default"
database = "default"
secure = 0
